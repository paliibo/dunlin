# Postgres. The role must not be a superuser — superusers bypass row-level
# security, and RLS is what keeps tenants apart. compose.yaml creates `dunlin`.
DATABASE_URL=postgres://dunlin:dunlin@127.0.0.1:5433/dunlin
REDIS_URL=redis://127.0.0.1:6380

# api | worker | all — which halves of the process to start. `all` for local dev.
DUNLIN_ROLE=all
PORT=3000

# Apply pending migrations when the process starts. Set to 0 where a deploy
# pipeline runs `pnpm db:migrate` itself.
DB_MIGRATE_ON_BOOT=1

# Creates tenants and issues their first API key (X-Platform-Token header).
# openssl rand -base64 32
PLATFORM_TOKEN=dev-only-platform-token-change-me

# Leave unset to log mail as JSON instead of sending it. compose.yaml runs
# Mailpit on 1025 (SMTP) and 8025 (inbox UI).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Dunlin Billing <billing@dunlin.local>"

# Where links in mail and webhooks point.
PUBLIC_BASE_URL=http://localhost:3000

# Daily dunning scan, cron syntax, UTC.
DUNNING_CRON=0 6 * * *

LOG_LEVEL=info
